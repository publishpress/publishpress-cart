<?xml version="1.0"?>
<ruleset name="PHPMD rule set"
         xmlns="http://pmd.sf.net/ruleset/1.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0 http://pmd.sf.net/ruleset_xml_schema.xsd"
         xsi:noNamespaceSchemaLocation="http://pmd.sf.net/ruleset_xml_schema.xsd">
    <description>Custom rule set for PublishPress Cart</description>

    <!-- Scope mirrors phpmetrics.json excludes -->
    <exclude-pattern>*/.agents/*</exclude-pattern>
    <exclude-pattern>*/.claude/*</exclude-pattern>
    <exclude-pattern>*/.codegraph/*</exclude-pattern>
    <exclude-pattern>*/.cursor/*</exclude-pattern>
    <exclude-pattern>*/.ddev/*</exclude-pattern>
    <exclude-pattern>*/.git/*</exclude-pattern>
    <exclude-pattern>*/.github/*</exclude-pattern>
    <exclude-pattern>*/.opencode/*</exclude-pattern>
    <exclude-pattern>*/.vscode/*</exclude-pattern>
    <exclude-pattern>*/.web/*</exclude-pattern>
    <exclude-pattern>*/.wordpress-org/*</exclude-pattern>
    <exclude-pattern>*/dev-workspace-cache/*</exclude-pattern>
    <exclude-pattern>*/dev-workspace/*</exclude-pattern>
    <exclude-pattern>*/dist/*</exclude-pattern>
    <exclude-pattern>*/docs/*</exclude-pattern>
    <exclude-pattern>*/languages/*</exclude-pattern>
    <exclude-pattern>*/lib/vendor/*</exclude-pattern>
    <exclude-pattern>*/metrics/*</exclude-pattern>
    <exclude-pattern>*/tests/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>

    <!--
        Architecture (Arch. 4.0): god files, blob classes, coupling
        Maps to PHPMetrics: "Too long", "Blob / God object", "Too complex class code"
    -->

    <rule ref="rulesets/codesize.xml/ExcessiveClassLength">
        <properties>
            <!-- PHPMetrics flags classes &gt;200 logical LOC; god-file audit threshold is 700 -->
            <property name="minimum" value="700"/>
        </properties>
    </rule>

    <rule ref="rulesets/codesize.xml/ExcessiveClassComplexity">
        <properties>
            <!-- PHPMetrics "Too complex class code" errors start around WMC/CC 40 -->
            <property name="maximum" value="40"/>
        </properties>
    </rule>

    <rule ref="rulesets/design.xml/CouplingBetweenObjects">
        <properties>
            <property name="maximum" value="10"/>
        </properties>
    </rule>

    <rule ref="rulesets/codesize.xml/TooManyMethods">
        <properties>
            <!-- PPCart_Public has 101 methods today; healthy classes stay small -->
            <property name="maxmethods" value="20"/>
        </properties>
    </rule>

    <rule ref="rulesets/codesize.xml/TooManyPublicMethods">
        <properties>
            <property name="maxmethods" value="12"/>
        </properties>
    </rule>

    <rule ref="rulesets/codesize.xml/TooManyFields">
        <properties>
            <property name="maxfields" value="12"/>
        </properties>
    </rule>

    <rule ref="rulesets/codesize.xml/ExcessivePublicCount">
        <properties>
            <property name="minimum" value="15"/>
        </properties>
    </rule>

    <rule ref="rulesets/design.xml/DepthOfInheritance">
        <properties>
            <property name="minimum" value="5"/>
        </properties>
    </rule>

    <rule ref="rulesets/design.xml/NumberOfChildren">
        <properties>
            <property name="minimum" value="3"/>
        </properties>
    </rule>

    <!--
        Maintainability (Maint. 4.0): long methods, globals, branching
        Maps to PHPMetrics: "Too complex method code", avg CC ≤20, large fns &gt;100 lines
    -->

    <rule ref="rulesets/codesize.xml/ExcessiveMethodLength">
        <properties>
            <property name="minimum" value="100"/>
        </properties>
    </rule>

    <rule ref="rulesets/codesize.xml/CyclomaticComplexity">
        <properties>
            <!-- PHPMetrics method errors from CC 11+; near-term refactor target is &lt;12 -->
            <property name="reportLevel" value="12"/>
        </properties>
    </rule>

    <rule ref="rulesets/codesize.xml/NPathComplexity">
        <properties>
            <property name="minimum" value="150"/>
        </properties>
    </rule>

    <rule ref="rulesets/codesize.xml/ExcessiveParameterList">
        <properties>
            <property name="minimum" value="8"/>
        </properties>
    </rule>

    <rule ref="rulesets/controversial.xml/Superglobals"/>

    <!--
        Clean code + dead code — supports Maint. and violation count reduction
    -->

    <rule ref="rulesets/cleancode.xml/BooleanArgumentFlag"/>

    <rule ref="rulesets/unusedcode.xml"/>

    <!--
        Naming — low-noise defaults for legacy WordPress class prefixes (PPCart_, etc.)
    -->

    <rule ref="rulesets/naming.xml/ShortVariable">
        <properties>
            <property name="minimum" value="3"/>
            <property name="exceptions" value="id,i,j,k,e,ex,wp"/>
        </properties>
    </rule>

    <rule ref="rulesets/naming.xml/LongVariable">
        <properties>
            <property name="maximum" value="50"/>
        </properties>
    </rule>

    <rule ref="rulesets/naming.xml/ShortMethodName">
        <properties>
            <property name="minimum" value="3"/>
        </properties>
    </rule>

    <rule ref="rulesets/naming.xml/ConstructorWithNameAsEnclosingClass">
        <properties>
            <property name="exceptions" value="__construct"/>
        </properties>
    </rule>
</ruleset>
