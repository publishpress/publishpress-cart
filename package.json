{
  "name": "publishpress-cart",
  "version": "1.0.0",
  "description": "PublishPress Cart — WordPress ecommerce plugin",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "lib": "lib",
    "test": "tests"
  },
  "dependencies": {
    "@wordpress/scripts": "^35.0.0",
    "clone-deep": "^4.0.1",
    "commander": "^14.0.3",
    "cross-spawn": "^7.0.6",
    "envinfo": "^7.21.0",
    "es-errors": "^1.3.0",
    "find-up": "^4.1.0",
    "flat": "^5.0.2",
    "function-bind": "^1.1.2",
    "hasown": "^2.0.4",
    "import-local": "^3.2.0",
    "interpret": "^3.1.1",
    "is-core-module": "^2.16.2",
    "is-plain-object": "^2.0.4",
    "isexe": "^2.0.0",
    "isobject": "^3.0.1",
    "kind-of": "^6.0.3",
    "locate-path": "^5.0.0",
    "p-limit": "^2.3.0",
    "p-locate": "^4.1.0",
    "p-try": "^2.2.0",
    "path-exists": "^4.0.0",
    "path-key": "^3.1.1",
    "path-parse": "^1.0.7",
    "pkg-dir": "^4.2.0",
    "playwright": "^1.62.1",
    "rechoir": "^0.8.0",
    "resolve": "^1.22.12",
    "resolve-cwd": "^3.0.0",
    "resolve-from": "^5.0.0",
    "shallow-clone": "^3.0.1",
    "shebang-command": "^2.0.0",
    "shebang-regex": "^3.0.0",
    "supports-preserve-symlinks-flag": "^1.0.0",
    "webpack-cli": "^7.0.3",
    "webpack-merge": "^6.0.1",
    "which": "^2.0.2",
    "wildcard": "^2.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@rambleventures/scribe": "^0.1.0",
    "@types/node": "^26.0.1",
    "gray-matter": "^4.0.3",
    "yaml": "^2.8.0"
  },
  "scripts": {
    "scribe": "scribe dev",
    "scribe:doctor": "scribe doctor",
    "scribe:init": "scribe init",
    "scribe:update": "scribe update",
    "test:docs:import": "node tests/tools/test-docs/scripts/import-spreadsheet.mjs",
    "test:docs:import-rt": "node tests/tools/test-docs/scripts/import-rt-cases.mjs",
    "test:docs:sync": "node tests/tools/test-docs/scripts/check-catalog-sync.mjs",
    "test:jev:regression": "node tests/tools/jev-regression-effectiveness/run.mjs",
    "test:e2e": "playwright test",
    "test:e2e:regression": "playwright test tests/playwright/regression --grep @regression",
    "test:e2e:regression:mocked": "REGRESSION_MOCKED_GATEWAYS=1 REGRESSION_REAL_PAYPAL=0 playwright test tests/playwright/regression --grep @regression",
    "test:e2e:regression:ui": "playwright test --ui tests/playwright/regression --grep @regression",
    "test:e2e:smoke": "playwright test tests/playwright/smoke --grep @smoke",
    "test:e2e:smoke:ui": "playwright test --ui tests/playwright/smoke --grep @smoke",
    "test:e2e:stripe": "playwright test tests/playwright/regression --grep @stripe",
    "test:e2e:paypal": "playwright test tests/playwright/regression --grep @paypal",
    "test:e2e:free": "playwright test tests/playwright/regression --grep @free",
    "test:e2e:validate": "playwright test --list",
    "test:e2e:admin": "playwright test tests/playwright/admin --grep @admin --grep-invert @email",
    "test:e2e:admin:core": "playwright test tests/playwright/admin --grep @admin-core",
    "test:e2e:admin:fixtures": "playwright test tests/playwright/admin --grep @admin-fixture",
    "test:e2e:admin:workflows": "playwright test tests/playwright/admin --grep @admin-workflow",
    "test:e2e:admin:ui": "playwright test --ui tests/playwright/admin --grep @admin",
    "test:e2e:email": "playwright test --grep @email --workers=1",
    "test:e2e:email:ui": "playwright test --ui tests/playwright/admin --grep @email",
    "test:e2e:list": "playwright test --list",
    "test:e2e:headed": "PW_HEADED=1 playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright test && playwright show-report",
    "build:gutenberg": "wp-scripts build includes/integrations/gutenberg/blocks/checkout-form/order-form.js includes/integrations/gutenberg/blocks/account-page-builder/account-blocks.js includes/integrations/gutenberg/blocks/account-page-builder/account-page-view.js --output-path=includes/integrations/gutenberg/build",
    "start:gutenberg": "wp-scripts start includes/integrations/gutenberg/blocks/checkout-form/order-form.js includes/integrations/gutenberg/blocks/account-page-builder/account-blocks.js includes/integrations/gutenberg/blocks/account-page-builder/account-page-view.js --output-path=includes/integrations/gutenberg/build",
    "test:e2e:gutenberg": "playwright test --config=includes/integrations/gutenberg/playwright.config.js",
    "test:e2e:checkout-block": "bash tests/legacy/e2e/checkout-block/run.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/publishpress/publishpress-cart.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/publishpress/publishpress-cart/issues"
  },
  "homepage": "https://github.com/publishpress/publishpress-cart#readme",
  "overrides": {
    "brace-expansion": "5.0.6",
    "markdownlint-cli": {
      "minimatch": "3.1.5"
    },
    "uuid": "11.1.1",
    "serialize-javascript": "7.0.5",
    "ws": "8.20.1"
  }
}
