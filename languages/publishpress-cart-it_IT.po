#: includes/integrations/gutenberg/blocks/account-tab/block.json
msgctxt "block title"
msgid "Account Tab"
msgstr "Scheda dell'account"

#: includes/integrations/gutenberg/blocks/checkout-form/block.json
msgctxt "block title"
msgid "Checkout"
msgstr "Pagamento"

#: includes/integrations/gutenberg/blocks/account-downloads/block.json
msgctxt "block description"
msgid "Display the customer downloads account section when downloads are available."
msgstr ""
"Visualizza la sezione “Download” dell'account del cliente quando sono "
"disponibili dei download."

#: includes/integrations/gutenberg/blocks/account-login/block.json
msgctxt "block description"
msgid "Display the customer account login and password reset form."
msgstr ""
"Visualizza il modulo per l'accesso all'account cliente e per la "
"reimpostazione della password."

#: includes/integrations/gutenberg/blocks/account-navigation/block.json
msgctxt "block description"
msgid "Display customer account navigation tabs and sortable account sections."
msgstr ""
"Visualizza le schede di navigazione dell'account cliente e le sezioni "
"ordinabili dell'account."

#: includes/integrations/gutenberg/blocks/account-orders/block.json
msgctxt "block description"
msgid "Display the customer order history account section."
msgstr ""
"Visualizza la sezione del profilo relativa alla cronologia degli ordini del "
"cliente."

#: includes/integrations/gutenberg/blocks/account-page-builder/block.json
msgctxt "block description"
msgid "Build a customer account page from sortable account component blocks."
msgstr ""
"Crea una pagina dell'account cliente utilizzando blocchi di componenti di "
"account ordinabili."

#: includes/integrations/gutenberg/blocks/account-payment-plans/block.json
msgctxt "block description"
msgid "Display the customer installment plans account section."
msgstr ""
"Visualizza la sezione dell'account relativa ai piani di pagamento rateale "
"del cliente."

#: includes/integrations/gutenberg/blocks/account-profile/block.json
msgctxt "block description"
msgid "Display the customer profile account section."
msgstr "Visualizza la sezione dell'account del profilo cliente."

#: includes/integrations/gutenberg/blocks/account-subscriptions/block.json
msgctxt "block description"
msgid "Display the customer subscriptions account section."
msgstr "Visualizza la sezione relativa agli abbonamenti del cliente."

#: includes/integrations/gutenberg/blocks/account-tab/block.json
msgctxt "block description"
msgid "Group account component blocks inside one account navigation tab."
msgstr ""
"Blocchi di componenti dell'account di gruppo all'interno di una scheda di "
"navigazione dell'account."

#: includes/integrations/gutenberg/blocks/checkout-form/block.json
msgctxt "block description"
msgid "Display a checkout form."
msgstr "Visualizza un modulo di pagamento."
