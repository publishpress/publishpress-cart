msgid "Refund from {site_name}"
msgstr "Rambursare de la {site_name}"

#: includes/email/ppcart-template-functions/templates.php:230
msgid ""
"Order ID: {order_id}\n"
"Order Date: {order_date}\n"
"\n"
"You're receiving this email because we have processed your refund of {last_refund_amount}. It can take up to 10 days to appear on your statement, if it takes longer please contact your bank for assistance."
msgstr ""
"ID comandă: {order_id}  \n"
"Data comenzii: {order_date}  \n"
"\n"
"Primiți acest email deoarece am procesat rambursarea dvs. de {last_refund_amount}. Poate dura până la 10 zile pentru a apărea pe extracul dvs., dacă durează mai mult, vă rugăm să contactați banca dvs. pentru asistență."

#: includes/email/ppcart-template-functions/templates.php:242
msgid "Your {product_name} trial is about to end"
msgstr "Perioada de probă pentru {product_name} se apropie de sfârșit"

#: includes/email/ppcart-template-functions/templates.php:246
msgid ""
"Hi {customer_firstname},\n"
"\n"
"Your trial is ending on <strong>{next_bill_date}</strong>. Once your trial is complete, we will automatically charge the payment method we have on file for <strong>{order_amount}</strong>.\n"
"\n"
"To cancel your trial, please log in to <a href=\"{login}\">your account</a>.\n"
"\n"
"Thank you,\n"
"{site_name}"
msgstr ""
"Bună {customer_firstname},  \n"
"\n"
"Perioada dvs. de probă se va încheia pe <strong>{next_bill_date}</strong>. Odată ce perioada dvs. de probă este completă, vom percepe automat metoda de plată pe care o avem în fișier pentru <strong>{order_amount}</strong>.  \n"
"\n"
"Pentru a anula perioada de probă, vă rugăm să vă conectați la <a href=\"{login}\">contul dvs.</a>.  \n"
"\n"
"Vă mulțumim,  \n"
"{site_name}"

#: includes/email/ppcart-template-functions/templates.php:265
msgid "Upcoming payment reminder for {product_name}"
msgstr "Amintire pentru următoarea plată pentru {product_name}"

#: includes/email/ppcart-template-functions/templates.php:269
