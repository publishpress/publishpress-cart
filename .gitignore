# These are some examples of commonly ignored file patterns.
# You should customize this list as applicable to your project.
# Learn more about .gitignore:
#     https://www.atlassian.com/git/tutorials/saving-changes/gitignore

# Node artifact files
node_modules/
dist/
logs/
/vendor
/lib/**/.git
/lib/vendor/**/.github/
/lib/vendor/**/docs/
/lib/vendor/**/test/
/lib/vendor/**/tests/
/lib/vendor/**/.editorconfig
/lib/vendor/**/phpunit.xml
/lib/vendor/**/phpunit.xml.dist
/lib/vendor/**/README*
/lib/vendor/**/CHANGELOG*
/lib/vendor/**/ChangeLog

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# Maven
target/
dist/

# JetBrains IDE
.idea/

# Claude Code: in-repo worktrees only — they are live git checkouts.
.claude/worktrees/

# Unit test reports
TEST*.xml
playwright-report/
test-results/
tests/e2e-results/

# CI-provisioned WordPress site
.ci-wordpress/
.ci-wp-server.log
.ci-wp-server.pid

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

# Sonar
.scannerwork/
sonar-project.properties

.env
.env.bak
.zshrc
/.web/
/.ddev/
/cart-packed/
.site-*/

dev-workspace-cache/
.playwright-mcp

/metrics
/metrics-current
.php-cs-fixer.cache
phpmd.txt
metrics-report.json

# Playwright
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

/.codegraph/
/graphify-out
/tmp/
.bench-admin/
.web/
.ddev/
/cart-packed/
.site-*/

# Cursor
*.code-workspace

# Opencode
opencode.json
/.opencode/
.harness-memory
.phpactor.json
