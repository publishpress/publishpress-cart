<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="PublishPress"
         xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/squizlabs/PHP_CodeSniffer/master/phpcs.xsd">
    <description>Apply Coding Standards to all the plugin files</description>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg name="cache"/>
    <ini name="memory_limit" value="512M"/>
    <arg name="basepath" value="."/>
    <arg name="parallel" value="2"/>
    <arg value="ps"/>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/lib/vendor/*</exclude-pattern>
    <exclude-pattern>*/tests/*</exclude-pattern>
    <exclude-pattern>*/dev-workspace-cache/*</exclude-pattern>
    <exclude-pattern>*/dist/*</exclude-pattern>
    <exclude-pattern>*/includes/integrations/gutenberg/build/*</exclude-pattern>
    <exclude-pattern>/\.web/</exclude-pattern>
    <exclude-pattern>/\.ddev/</exclude-pattern>

    <file>admin/</file>
    <file>includes/</file>
    <file>models/</file>
    <file>public/</file>
    <file>publishpress-cart.php</file>

    <rule ref="WordPressVIPMinimum">
        <!-- Exclude JS-only sniffs to avoid PHPCS 4 deprecation noise when scanning PHP-only extensions. -->
        <exclude name="WordPressVIPMinimum.JS.DangerouslySetInnerHTML"/>
        <exclude name="WordPressVIPMinimum.JS.HTMLExecutingFunctions"/>
        <exclude name="WordPressVIPMinimum.JS.InnerHTML"/>
        <exclude name="WordPressVIPMinimum.JS.StringConcat"/>
        <exclude name="WordPressVIPMinimum.JS.StrippingTags"/>
        <exclude name="WordPressVIPMinimum.JS.Window"/>
    </rule>
    <rule ref="WordPress-VIP-Go">
        <exclude name="WordPressVIPMinimum.JS.DangerouslySetInnerHTML"/>
        <exclude name="WordPressVIPMinimum.JS.HTMLExecutingFunctions"/>
        <exclude name="WordPressVIPMinimum.JS.InnerHTML"/>
        <exclude name="WordPressVIPMinimum.JS.StringConcat"/>
        <exclude name="WordPressVIPMinimum.JS.StrippingTags"/>
        <exclude name="WordPressVIPMinimum.JS.Window"/>
    </rule>
    <rule ref="VariableAnalysis"/>
    <rule ref="PublishPressStandards"/>

    <rule ref="PSR12">
        <!-- WordPress plugin conventions -->
        <exclude name="PSR1.Classes.ClassDeclaration.MissingNamespace"/>
        <exclude name="PSR1.Classes.ClassDeclaration.InvalidClassName"/>
        <exclude name="Squiz.Classes.ValidClassName.NotCamelCaps"/>
        <exclude name="PSR1.Methods.CamelCapsMethodName"/>
        <exclude name="PSR2.Classes.PropertyDeclaration.Underscore"/>
        <exclude name="PSR2.Methods.MethodDeclaration.Underscore"/>
        <exclude name="Generic.Files.LineLength.TooLong"/>
        <exclude name="Generic.WhiteSpace.ScopeIndent"/>
        <exclude name="PSR1.Files.SideEffects.FoundWithSymbols"/>
    </rule>
</ruleset>
