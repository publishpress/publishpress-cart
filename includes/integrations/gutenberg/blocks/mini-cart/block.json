{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "publishpress-cart/mini-cart",
  "title": "Cart Mini Cart",
  "category": "widgets",
  "icon": "cart",
  "description": "Display a cart icon and open the shopping cart drawer.",
  "textdomain": "publishpress-cart",
  "render": "file:./render.php",
  "editorScript": "ppcart-mini-cart-editor",
  "style": "ppcart-shopping-cart",
  "attributes": {
    "showCount": {
      "type": "boolean",
      "default": true
    },
    "showTotal": {
      "type": "boolean",
      "default": false
    },
    "opensDrawer": {
      "type": "boolean",
      "default": true
    },
    "styleSettings": {
      "type": "object",
      "default": {}
    }
  },
  "supports": {
    "html": false
  }
}
