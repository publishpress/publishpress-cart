{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "publishpress-cart/checkout-form",
	"version": "1.0.0",
	"title": "Checkout",
	"category": "widgets",
	"icon": "cart",
	"description": "Display a checkout form.",
	"textdomain": "publishpress-cart",
	"render": "file:./render.php",
	"editorScript": "ppcart-checkout-form-editor",
	"style": "ppcart-checkout-form-style",
	"editorStyle": "ppcart-checkout-form-editor-style",
	"attributes": {
		"pid": {
			"type": "string",
			"default": ""
		},
		"hide_labels": {
			"type": "boolean",
			"default": false
		},
		"template": {
			"type": "string",
			"default": ""
		},
		"plan": {
			"type": "string",
			"default": ""
		},
		"coupon": {
			"type": "string",
			"default": ""
		},
		"styleSettings": {
			"type": "object",
			"default": {}
		},
		"contentOrder": {
			"type": "array",
			"default": []
		},
		"textSettings": {
			"type": "object",
			"default": {}
		},
		"anchor": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"align": [ "wide", "full" ],
		"anchor": true,
		"html": false,
		"spacing": {
			"margin": true
		}
	}
}
