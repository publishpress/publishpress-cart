{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "publishpress-cart/account-payment-plans",
	"version": "1.0.0",
	"title": "Account Installment Plans",
	"category": "widgets",
	"icon": "schedule",
	"description": "Display the customer installment plans account section.",
	"textdomain": "publishpress-cart",
	"render": "file:./render.php",
	"editorScript": "ppcart-account-page-editor",
	"style": "ppcart-account-block-style",
	"editorStyle": "ppcart-account-block-editor-style",
	"attributes": {
		"active": {
			"type": "boolean",
			"default": true
		},
		"blockStyle": {
			"type": "string",
			"default": ""
		},
		"itemLayout": {
			"type": "string",
			"default": ""
		},
		"statusPillStyle": {
			"type": "string",
			"default": "pill"
		},
		"actionButtonShape": {
			"type": "string",
			"default": "chip"
		},
		"rowHoverEffect": {
			"type": "string",
			"default": ""
		},
		"visibleGroups": {
			"type": "array",
			"default": [
				"all",
				"past_due",
				"completed"
			],
			"items": {
				"type": "string"
			}
		},
		"groupHeadingColor": {
			"type": "string",
			"default": ""
		},
		"groupHeadingFontSize": {
			"type": "number"
		},
		"groupHeadingFontWeight": {
			"type": "string",
			"default": ""
		},
		"groupHeadingTransform": {
			"type": "string",
			"default": ""
		},
		"actionLinkColor": {
			"type": "string",
			"default": ""
		},
		"actionLinkHoverColor": {
			"type": "string",
			"default": ""
		},
		"statusColor": {
			"type": "string",
			"default": ""
		},
		"emptyTextColor": {
			"type": "string",
			"default": ""
		},
		"anchor": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"align": [
			"wide",
			"full"
		],
		"anchor": true,
		"html": false,
		"spacing": {
			"margin": true
		}
	}
}
